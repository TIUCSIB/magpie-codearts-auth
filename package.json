{
  "name": "magpie-codearts-auth",
  "version": "0.1.1",
  "description": "Magpie / OpenCode provider plugin for HUAWEI CodeArts (码道): OAuth2 login, balance & quota reminders, daily check-in",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./server": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "README.md",
    "icon.svg",
    "panel"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie-plugin",
    "codearts",
    "huaweicloud"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TIUCSIB/magpie-codearts-auth.git"
  },
  "homepage": "https://github.com/TIUCSIB/magpie-codearts-auth",
  "scripts": {
    "test": "bun test"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 2,
    "panels": [
      {
        "slot": "provider",
        "file": "panel/checkin.html",
        "title": "每日签到",
        "titles": {
          "zh": "每日签到",
          "en": "Daily check-in"
        }
      }
    ],
    "options": {
      "channel": "benefit",
      "maasType": "",
      "autoCheckin": true,
      "account": "",
      "concurrencyRetries": 3,
      "concurrencyRetryDelayMs": 800,
      "maxInFlight": 1
    }
  }
}
